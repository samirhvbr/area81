APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Matomo Analytics (self-hosted em a.blue3.cloud)
# -----------------------------------------------------------------------------
# Rastreamento. O snippet só entra no <head> quando MATOMO_ENABLED=true E
# MATOMO_SITE_ID preenchido (config/services.php + partials/matomo.blade.php).
# Após ativar/alterar: php artisan config:cache.
MATOMO_ENABLED=false
MATOMO_URL=https://a.blue3.cloud/
MATOMO_SITE_ID=10

# -----------------------------------------------------------------------------
# Google tag (gtag.js), Google Analytics 4
# -----------------------------------------------------------------------------
# Injected into the public <head> when non-empty (config/services.php +
# partials/google-tag.blade.php). Left empty here so a local copy does not send
# hits; production falls back to the config default (G-GMMV9KTTFJ) when the key is
# absent from its .env. After changing it: php artisan config:cache.
GOOGLE_TAG_ID=

# -----------------------------------------------------------------------------
# Newsletter — proteção anti-abuso (list bombing)
# -----------------------------------------------------------------------------
# O formulário público /newsletter/subscribe dispara e-mail de confirmação
# (double opt-in) para QUALQUER endereço. Estas travas evitam que um bot use o
# formulário para bombardear caixas de terceiros e estourar a cota do provedor
# de SMTP. As demais barreiras (honeypot, tempo mínimo, cooldown por endereço)
# não têm env — ficam em config/newsletter.php.
#
# Teto GLOBAL de e-mails de confirmação por dia (kill-switch). Atingido o teto,
# novas inscrições recebem a tela de sucesso normal mas NADA é enviado até virar
# o dia; o fato é logado como critical e avisado por e-mail (se NEWSLETTER_ALERT_EMAIL).
NEWSLETTER_DAILY_CAP=50
# E-mail avisado (no máx. 1x/dia) quando o teto diário é atingido. Vazio = só log.
NEWSLETTER_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA opt-in do formulário de newsletter)
# -----------------------------------------------------------------------------
# Camada anti-bot OPCIONAL. Vazias = desligada (honeypot/tempo/cooldown/teto
# diário seguem ativos). Preenchidas = widget aparece no form e o submit é
# verificado server-side (fail-closed). Chaves em dash.cloudflare.com ->
# Turnstile (widget "Managed"). Após alterar: php artisan config:cache.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# pgvector — store vetorial para embeddings de news
# -----------------------------------------------------------------------------
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_DB=news_vector
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=

# -----------------------------------------------------------------------------
# Ollama
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GENERATE_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# Piper TTS
# -----------------------------------------------------------------------------
PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL=
PIPER_MODEL_CONFIG=
PIPER_OUTPUT_DIR=

# -----------------------------------------------------------------------------
# News Digest — ranking e digest
# -----------------------------------------------------------------------------
NEWS_ALPHA=0.7
NEWS_BETA=0.3
NEWS_TOP_N=5

# -----------------------------------------------------------------------------
# Canais de entrega
# -----------------------------------------------------------------------------
NEWS_CHANNEL_BLOG=true
NEWS_CHANNEL_TELEGRAM=false
NEWS_CHANNEL_DISCORD=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_AUDIO=false

DISCORD_WEBHOOK_URL=
